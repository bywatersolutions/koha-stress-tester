# ============================================================
# STEADY STATE - Daily Operations ( staff + patron on the shared pool )
# ============================================================
# Purpose: measure how staff activity and the public catalog contend for the
#          one shared Starman/Plack worker pool, post-go-live. Load shapes are
#          modeled on real access logs from 12 ByWater Koha libraries.
# ============================================================

BENCH=koha_steady_state.js

# --- Target & credentials --------------------------------------------------
STAFF_URL=https://staff.your-partner.org
OPAC_URL=https://your-partner.org
#STAFF_HOST_HEADER=
#OPAC_HOST_HEADER=
# Superlibrarian; needs RESTBasicAuth enabled on the target
STAFF_USER=koha
STAFF_PASS=koha

# --- Patron mode -----------------------------------------------------------
# aspen: emulate Aspen Discovery's load on Koha's REST API ( 10/12 libraries )
# opac:  direct Koha OPAC CGI browse ( e.g. PWPL, hccc, helm )
PATRON_MODE=aspen

# --- Load rates ------------------------------------------------------------
# Staff transactions/hour: one weighted desk operation per transaction
# ( checkin/checkout/detail/search/holds/patron ). A VU models a workstation
# that logs in ONCE and stays logged in, so this is the operation rate, not a
# login rate. Real peak-hour operation rates from logs: ~1,200 mid-size
# library, ~2,000 busy, ~9,000 large. Ladder up to find where p95 degrades.
STAFF_TRANSACTIONS_PER_HOUR=1500
# Patron account sessions/hour ( aspen mode )
PATRON_SESSIONS_PER_HOUR=2000
# opac mode instead: target searches/hour ( converted to sessions internally )
#OPAC_SEARCHES_PER_HOUR=12929

# --- Shape / duration ------------------------------------------------------
DURATION=5m
RAMP_TIME=30s
THINK_S=1
# VU pool overrides ( auto-sized generously otherwise; raise if dropped_iterations
# appear while latency is still healthy )
#STAFF_MAX_VUS=
#PATRON_MAX_VUS=

# --- Pass criteria ---------------------------------------------------------
# Abort/fail when either scenario's per-request p95 exceeds this
P95_MS=10000

# --- Ingress / cloud -------------------------------------------------------
#EXTERNAL_SERVICE_TOKEN=
CLOUD_TEST_NAME=koha-steady-state
#CLOUD_PROJECT_ID=
