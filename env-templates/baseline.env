# ============================================================
# BASELINE - Establish Performance Metrics
# ============================================================
# Purpose: Capture normal performance characteristics
# Duration: ~15-20 minutes
# Load: 15 VUs steady state
# ============================================================
# Run this first to establish what "normal" looks like.
# Compare future tests against this baseline.
# ============================================================

# Docker settings (run: id -u and id -g)
UID=1000
GID=1000

# BENCH: Which benchmark to run
#   - aspen_http.js  (Aspen, HTTP mode)
#   - solr_http.js   (Solr Cloud direct queries)
BENCH=aspen_http.js

# K6_IMAGE_TAG: Docker image to use
#   - latest              (HTTP mode, smaller image)
#   - latest-with-browser (browser mode)
K6_IMAGE_TAG=latest

# ============================================================
# Target URLs & Credentials (CONFIGURE THESE FIRST)
# ============================================================

# Aspen Discovery (aspen_http.js)
ASPEN_BASE_URL=https://your-instance.org
# If ASPEN_BASE_URL is localhost, set ASPEN_HOST_HEADER to the real domain
# Comment this out if hitting the domain directly
ASPEN_HOST_HEADER=your-instance.org

# Solr (solr_http.js)
SOLR_URL=http://your-solr:8983
SOLR_CORE=grouped_works_v2
SOLR_USER=
SOLR_PASS=

# ============================================================
# BASELINE PROFILE - Low VUs, extended holds to capture stable metrics
# ============================================================

MAX_VUS=15
VU_STEP=5
RAMP_TIME=15s
HOLD_TIME=120s

# Abort test when p(THRESHOLD_PERCENTILE) response time exceeds ABORT threshold
# Lower percentile = more tolerant of slow outliers (e.g., 90 = allow 10% slow)
# Higher percentile = stricter (e.g., 99 = only allow 1% slow)
THRESHOLD_PERCENTILE=95
ASPEN_ABORT_MS=3000
SOLR_ABORT_MS=500
ASPEN_REQUEST_TIMEOUT=5s

# MAX_FAIL_CON_RATE: Maximum allowed connection/request failure rate (0.0-1.0)
# Test aborts if failure rate exceeds this threshold
# Very low tolerance - baseline should be easy for the system
ASPEN_MAX_FAIL_CON_RATE=0.005
SOLR_MAX_FAIL_CON_RATE=0.005

# Console logging: log individual slow requests above this threshold (ms)
# Low thresholds - log anything even slightly slow
ASPEN_SLOW_LOG_MS=1500
SOLR_SLOW_LOG_MS=300
STATS_INTERVAL=30
HARD_TIMEOUT=30m
HOLD_ON_FAIL=15s

# Think time between actions
#   (blank)  = random delays (realistic user simulation)
#   off      = no delays (maximum request rate)
#   2        = fixed 2-second delay (or any number)
THINK_TIME=
