# ============================================================
# REALISTIC - Calibrated Real-Usage Workload
# ============================================================
# Purpose: Replay a measured production workload (open model)
# Duration: RAMP_TIME + DURATION + RAMP_TIME (default ~70 min)
# Load: Arrival rate measured from production logs
# ============================================================
# Unlike the other profiles, this one models *real human usage*:
# sessions arrive at the measured hourly rate whether or not the
# server keeps up, search terms are real weighted patron queries,
# and think times / click-through come from measured distributions.
#
# Prerequisites (see docs/CALIBRATION.md):
#   1. Run bin/analyze-koha-logs.pl on production Apache logs
#   2. Copy calibration.json and search_terms.json into benchmarks/data/
#   3. Set OPAC_SEARCHES_PER_HOUR below from arrival.searches_per_hour
#
# The committed *.example.json files work for a smoke test, but
# they do NOT represent your library's real workload.
# ============================================================

# Docker settings (run: id -u and id -g)
UID=1000
GID=1000

# BENCH: Which benchmark to run
#   - koha_opac_http.js     (patron catalog sessions - primary)
#   - koha_workflow_http.js (staff circulation - set WORKFLOW_RATE_PER_HOUR)
BENCH=koha_opac_http.js

# K6_IMAGE_TAG: Docker image to use
K6_IMAGE_TAG=latest

# ============================================================
# Target URLs & Credentials (CONFIGURE THESE FIRST)
# ============================================================
# Point at a STAGING CLONE with a copy of the production bib DB -
# real search terms against a different database skew hit counts.

OPAC_URL=https://staging-clone.example.org
#OPAC_HOST_HEADER=

# Staff side (koha_workflow_http.js only)
STAFF_URL=https://staging-clone-intra.example.org
#STAFF_HOST_HEADER=
STAFF_USER=koha
STAFF_PASS=koha

# ============================================================
# REALISTIC PROFILE - Calibrated open-model workload
# ============================================================

# Calibration outputs from bin/analyze-koha-logs.pl, relative to benchmarks/
SEARCH_TERMS_FILE=data/search_terms.json
CALIBRATION_FILE=data/calibration.json

# Session arrival rate: arrival.sessions_per_hour from calibration.json.
# Target OPAC searches per hour; the script converts this to a session
# arrival rate internally (a session issues the main search plus a subject
# browse). E.g. the 12,929 peak-hour searches: OPAC_SEARCHES_PER_HOUR=12929
OPAC_SEARCHES_PER_HOUR=1222

# Steady-state duration at the target rate (match the measured window)
DURATION=60m
RAMP_TIME=5m

# Open-model VU pool: leave 0 to auto-estimate from the rate. If the run
# reports dropped_iterations during *healthy* latencies, raise this.
PRE_ALLOCATED_VUS=0
# Safety cap on VUs the arrival-rate executor may spin up
MAX_VUS=400

# Staff circulation rate (koha_workflow_http.js): peak-hour checkout count
# from the Koha statistics table (see docs/CALIBRATION.md, Measure step 3)
#WORKFLOW_RATE_PER_HOUR=85

# Think time: leave blank to sample the measured distribution from
# CALIBRATION_FILE (capped at 120s). "off" or a number override it.
THINK_TIME=

# Click-through overrides: leave blank to use calibration.json values
#CLICK_THROUGH_RATE=
#DETAIL_VIEWS_PER_SEARCH=

# ============================================================
# Relaxed abort thresholds - a validation run should record the
# server struggling, not abort at the first slow percentile
# ============================================================
THRESHOLD_PERCENTILE=95
KOHA_OPAC_ABORT_MS=30000
KOHA_OPAC_REQUEST_TIMEOUT=15s
KOHA_OPAC_MAX_FAIL_CON_RATE=0.25
KOHA_OPAC_SLOW_LOG_MS=3000
KOHA_WORKFLOW_ABORT_MS=30000
KOHA_WORKFLOW_REQUEST_TIMEOUT=30s
KOHA_WORKFLOW_MAX_FAIL_CON_RATE=0.25
KOHA_WORKFLOW_SLOW_LOG_MS=5000
HOLD_ON_FAIL=60s
HARD_TIMEOUT=90m
