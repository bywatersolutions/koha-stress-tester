# ============================================================
# TRAINING SESSION - N Librarians in Lockstep (Koha staff client)
# ============================================================
# Purpose: Certify that a Koha server survives a training class -
#          LIBRARIANS real Chromium browsers all doing the same staff
#          exercise at the same moment (login, checkout, checkin,
#          search, place hold), paced by a shared trainer clock.
# Duration: STEPS x STEP_INTERVAL_S, ~12 minutes at the defaults
# Load: LIBRARIANS concurrent browsers - far too heavy for a laptop
#       at 75; run via Grafana Cloud (see docs/TRAINING.md)
# ============================================================

BENCH=koha_training_browser.js

# ============================================================
# Target & Credentials (CONFIGURE THESE FIRST, per deployment)
# ============================================================

# Koha staff interface base URL
STAFF_URL=https://staff.your-partner.org
# If STAFF_URL is an internal address, set the real vhost here
#STAFF_HOST_HEADER=staff.your-partner.org

# Superlibrarian used for API record selection (and as the shared login
# when TRAINING_USER_PREFIX is unset). The target must have the
# RESTBasicAuth system preference enabled or every API call 401s.
# On Grafana Cloud runs, leave STAFF_PASS unset and store the password as
# a cloud secret named 'staff-pass' instead (STAFF_PASS_SECRET overrides
# the name).
STAFF_USER=koha
STAFF_PASS=koha

# ============================================================
# Class Shape
# ============================================================

# How many attendees (browsers)
LIBRARIANS=75

# Seconds between trainer "now do this" ticks, and the human reaction
# spread after each tick. Typing steps (patron/catalog search) spread
# over TYPING_JITTER_S; scan/click steps over STEP_JITTER_S. Logins get
# their own LOGIN_JITTER_S window - trainers deliberately have trainees
# stagger logins - and the first exercise tick starts after it closes.
STEP_INTERVAL_S=90
STEP_JITTER_S=5
#TYPING_JITTER_S=15
#LOGIN_JITTER_S=60

# Delay before the first tick so all browsers finish launching and the
# login burst is truly simultaneous
#STARTUP_GRACE_S=15

# Per-attendee staff logins created with bin/seed-training-users.pl.
# Leave unset to have every attendee log in as STAFF_USER instead.
#TRAINING_USER_PREFIX=training
#TRAINING_USER_PASS=S3cretTraining!

# The shared "everyone search for this" exercise; pick something that
# has hits in the target catalog
CATALOG_SEARCH_TERM=harry potter

# The class uses EXISTING patrons and available items (LIBRARIANS + 1 of
# each); these optionally scope the selection to a branch or category
#LIBRARY_ID=MAIN
#PATRON_CATEGORY_ID=PT

# Explicit hold-target bib for the everyone-holds-the-same-record exercise;
# default: a bib whose copies are all checked out, found or arranged
#HOLD_BIBLIO_ID=

# ============================================================
# Pass Criteria
# ============================================================

# p95 ceiling per exercise, in ms - "nobody's screen hung"
STEP_P95_MS=15000

# Fraction of step executions that must complete; the default tolerates
# roughly one retrying trainee per 75-person class per exercise
#CHECKS_RATE=0.98

# ============================================================
# Restricted Ingress Header (optional)
# ============================================================

# Header name sent on every request so the ingress can allowlist test
# traffic. The value comes from EXTERNAL_SERVICE_TOKEN locally; on
# Grafana Cloud runs leave it unset and store the value as a cloud
# secret named EXTERNAL_SERVICE_TOKEN_SECRET instead (docs/TRAINING.md).
#EXTERNAL_SERVICE_HEADER=x-grafana-cloud-external-service
#EXTERNAL_SERVICE_TOKEN=
#EXTERNAL_SERVICE_TOKEN_SECRET=x-grafana-cloud-external-service-token

# ============================================================
# Grafana Cloud
# ============================================================

# Shown as the test name in the k6 app; set the project id from the
# project's page at https://bws.grafana.net/a/k6-app
CLOUD_TEST_NAME=koha-training-session
#CLOUD_PROJECT_ID=

# Browser mode; keep headless
K6_BROWSER_HEADLESS=true
