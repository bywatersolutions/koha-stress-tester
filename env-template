# ============================================================
# Stress Testing Environment Configuration
# ============================================================
# COPY THIS TO .env AND CONFIGURE
# ============================================================

# SCRIPT: Which test script to run
#   - aspen_http.js  (Aspen, HTTP mode for headless servers)
#   - aspen.js       (Aspen, browser mode)
#   - koha.js        (Koha, browser mode)
#   - solr_http.js   (Solr Cloud direct queries)
SCRIPT=aspen_http.js

# K6_IMAGE_TAG: Docker image to use
#   - latest              (HTTP mode, smaller image)
#   - latest-with-browser (browser mode)
K6_IMAGE_TAG=latest

# ============================================================
# k6 Test Parameters
# ============================================================
VUS=1
ITERATIONS=1

# ============================================================
# Aspen Discovery Configuration
# ============================================================
# Used with aspen.js or aspen_http.js

BASE_URL=https://localhost

# If BASE_URL is localhost, set HOST_HEADER to the real domain
HOST_HEADER=INST.aspendiscovery.org

# Number of search results to click through per iteration
RESULTS_TO_CLICK=5

# ============================================================
# Staged Load Test Parameters
# ============================================================
# Used with aspen_http.js and solr_http.js

MAX_VUS=300
VU_STEP=10
RAMP_TIME=5s
HOLD_TIME=5s
STATS_INTERVAL=10
HARD_TIMEOUT=30m
HOLD_ON_FAIL=30s

# Output file for JSON results (leave empty for no file output)
# File is written to ./output/ directory
OUTPUT_FILE=/output/results.json

# ============================================================
# Solr Cloud Configuration
# ============================================================
# Used with solr_http.js

SOLR_URL=http://solr.gke.aspendiscovery.org
SOLR_CORE=grouped_works_v2
SOLR_USER=
SOLR_PASS=

# ============================================================
# Koha Configuration
# ============================================================
# Used with koha.js

STAFF_URL=https://kohadev-intra.localhost
OPAC_URL=https://kohadev.localhost

# Staff user credentials for API access and login
STAFF_USER=koha
STAFF_PASS=koha
