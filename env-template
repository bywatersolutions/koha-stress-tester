# ============================================================
# Stress Testing Environment Configuration
# ============================================================
# COPY THIS TO .env AND CONFIGURE
# ============================================================

# ============================================================
# Run docker as user
# ============================================================
# Run: id -u and id -g to get your values
UID=1000
GID=1000

# BENCH: Which benchmark to run
#
# HTTP mode scripts (use K6_IMAGE_TAG=latest):
#   - aspen_http.js         (Aspen Discovery HTTP stress test)
#   - koha_workflow_http.js (Koha full workflow: create/checkout/checkin/delete)
#   - koha_api_http.js      (Koha REST API read-only queries)
#   - koha_opac_http.js     (Koha OPAC patron interface)
#   - solr_http.js          (Solr Cloud direct queries)
#
# Browser mode scripts (use K6_IMAGE_TAG=latest-with-browser):
#   - aspen_browser.js      (Aspen Discovery browser test)
#   - koha_browser.js       (Koha browser workflow test)
#
BENCH=solr_http.js

# K6_IMAGE_TAG: Docker image to use (must match BENCH script type)
#   - latest              (HTTP scripts: *_http.js - smaller, faster)
#   - latest-with-browser (Browser scripts: aspen_browser.js, koha_browser.js)
# NOTE: Using wrong image will cause test to fail!
K6_IMAGE_TAG=latest

# ============================================================
# Target URLs & Credentials (CONFIGURE THESE FIRST)
# ============================================================

# Aspen Discovery (aspen_browser.js, aspen_http.js)
ASPEN_BASE_URL=https://localhost
# If ASPEN_BASE_URL is localhost, set ASPEN_HOST_HEADER to the real domain
# Comment this out if hitting the domain directly
ASPEN_HOST_HEADER=INST.aspendiscovery.org

# Solr (solr_http.js)
# Default port is 8983 for Solr Cloud; standalone Solr may use 8080
SOLR_URL=http://localhost:8983
SOLR_CORE=grouped_works_v2
SOLR_USER=
SOLR_PASS=
# SOLR_HOST_IP: Map hostname to IP (for Tailscale, VPNs, or custom DNS)
# Set this if k6 can't resolve the SOLR_URL hostname
# Get the IP with: tailscale ip -4 <hostname> or getent hosts <hostname>
#SOLR_HOST_IP=
# For Helm/K8s:
# K6_NAMESPACE: deploy to same namespace as Solr to access existing secrets
#K6_NAMESPACE=solr-cloud
# SOLR_SECRET: name of secret containing password (must exist in K6_NAMESPACE)
#SOLR_SECRET=solr-credentials
#SOLR_SECRET_KEY=password

# Koha (koha_browser.js, koha_workflow_http.js, koha_api_http.js, koha_opac_http.js)
STAFF_URL=https://kohadev-intra.localhost
OPAC_URL=https://kohadev.localhost
STAFF_USER=koha
STAFF_PASS=koha
# If URLs are localhost, set HOST_HEADERs to the real domains
# Comment these out if hitting the domains directly
STAFF_HOST_HEADER=kohadev-intra.example.org
OPAC_HOST_HEADER=kohadev.example.org

# ============================================================
# Browser Mode Parameters (aspen_browser.js, koha_browser.js)
# ============================================================
VUS=1
ITERATIONS=1

# K6_BROWSER_HEADLESS: Run browser in headless mode (no visible window)
# true = headless (default, faster, works in containers)
# false = visible browser window (useful for debugging, requires display)
K6_BROWSER_HEADLESS=true

# Number of search results to click through per iteration
RESULTS_TO_CLICK=5

# ============================================================
# Staged Load Test Parameters (HTTP mode scripts)
# ============================================================

MAX_VUS=150
VU_STEP=10
RAMP_TIME=5s
HOLD_TIME=5s

# Abort test when p(THRESHOLD_PERCENTILE) response time exceeds ABORT threshold
# Lower percentile = more tolerant of slow outliers (e.g., 90 = allow 10% slow)
# Higher percentile = stricter (e.g., 99 = only allow 1% slow); p95 avoids the
# twitchiness of p98 while still catching real degradation
THRESHOLD_PERCENTILE=95

# Aspen thresholds (aspen_http.js)
ASPEN_ABORT_MS=12000
ASPEN_REQUEST_TIMEOUT=10s
ASPEN_MAX_FAIL_CON_RATE=0.05
ASPEN_SLOW_LOG_MS=6000

# Koha Workflow thresholds (koha_workflow_http.js)
# Full CRUD workflow: create patron/biblio/item, checkout, checkin, delete
# Lower VUs and higher timeouts since each iteration does many write operations
KOHA_WORKFLOW_ABORT_MS=10000
KOHA_WORKFLOW_REQUEST_TIMEOUT=30s
KOHA_WORKFLOW_MAX_FAIL_CON_RATE=0.10
KOHA_WORKFLOW_SLOW_LOG_MS=5000

# Koha API thresholds (koha_api_http.js)
# Read-only API queries - higher throughput testing
KOHA_API_ABORT_MS=5000
KOHA_API_REQUEST_TIMEOUT=10s
KOHA_API_MAX_FAIL_CON_RATE=0.05
KOHA_API_SLOW_LOG_MS=2000

# Koha OPAC thresholds (koha_opac_http.js). Abort when p95 search time exceeds
# 10s or >5% of requests fail - the line between a loaded-but-usable OPAC and a
# saturated one. Raise all three for a characterization ladder (measure, don't
# abort).
KOHA_OPAC_ABORT_MS=10000
KOHA_OPAC_REQUEST_TIMEOUT=15s
KOHA_OPAC_MAX_FAIL_CON_RATE=0.05
KOHA_OPAC_SLOW_LOG_MS=3000

# Solr thresholds (solr_http.js)
SOLR_ABORT_MS=2000
SOLR_MAX_FAIL_CON_RATE=0.05
SOLR_SLOW_LOG_MS=800

# Common settings
STATS_INTERVAL=10
HARD_TIMEOUT=30m
HOLD_ON_FAIL=30s

# Think time between actions (HTTP mode scripts)
#   (blank)  = random delays (realistic user simulation), or the measured
#              distribution when CALIBRATION_FILE is set (see below)
#   off      = no delays (maximum request rate)
#   2        = fixed 2-second delay (or any number)
THINK_TIME=

# ============================================================
# Calibrated / Open-Model Parameters (koha_opac_http.js,
# koha_workflow_http.js) - see docs/CALIBRATION.md
# ============================================================
# All optional. Unset = legacy staged closed-model behavior above.
# Generate the data files with bin/analyze-koha-logs.pl from production
# Apache logs; they must live under benchmarks/ (paths are relative to it)
# and are gitignored because real search terms can contain patron PII.

# Weighted real search terms (koha_opac_http.js)
#SEARCH_TERMS_FILE=data/search_terms.json

# Measured think times, click-through rate, paging rate (koha_opac_http.js)
#CALIBRATION_FILE=data/calibration.json

# Open model: drive this many opac-search.pl requests per hour regardless of
# server speed (ramping-arrival-rate executor) instead of the staged VU ramp.
# The script converts it to a session rate (a session issues > 1 search).
# Use arrival.searches_per_hour from calibration.json
#OPAC_SEARCHES_PER_HOUR=

# Expert override: sessions per SECOND (wins over OPAC_SEARCHES_PER_HOUR)
#ARRIVAL_RATE=

# Steady-state duration at the target rate (open model only)
#DURATION=60m

# Open-model VU pool; 0 = auto-estimate from the rate. Raise if k6 reports
# dropped_iterations while latencies are still healthy.
#PRE_ALLOCATED_VUS=0

# Probabilistic click-through overrides (else taken from CALIBRATION_FILE)
#CLICK_THROUGH_RATE=
#DETAIL_VIEWS_PER_SEARCH=

# Staff circulation arrival rate (koha_workflow_http.js): one iteration is
# one checkout + checkin, so use the peak-hour checkout count from the
# Koha statistics table
#WORKFLOW_RATE_PER_HOUR=

# Connection reuse behavior (HTTP mode scripts)
# By default, each VU reuses connections (HTTP keep-alive) across all requests,
# which simulates real browser behavior and tests sustained server capacity.
# Set to true/on/1 to disable connection reuse (fresh TCP connection per request),
# which tests connection handling overhead and connection storm scenarios.
#   (blank)  = reuse connections (default, realistic browser behavior)
#   true     = fresh connection per request (tests connection handling)
NO_CONNECTION_REUSE=

# Output file for JSON results (leave empty for auto-generated names)
# File is written to ./output/ directory
# Format: script-testnumber-shortdate-time.json (e.g., solr-001-20260108-2345.json)
# Test number auto-increments based on existing files in output/
OUTPUT_FILE=
